# Copy this file to .env and set a unique secret before starting Compose.
JWT_SECRET=
APP_ENV=development

# Public frontend build settings (VITE_ values are embedded in the website/app).
# Use the deployed HTTPS API base, including /api, for Vercel and Android builds.
VITE_API_BASE_URL=

# Required by Docker Compose. Set this to a PostgreSQL connection string.
DATABASE_URL=

# Optional Supabase Storage integration. Keep the service-role key private;
# it is passed only to the backend container.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Identity Services Web client ID (also set as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# SMTP provider used to deliver registration verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional application settings
APP_PORT=5173
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AI_CONFIDENCE_THRESHOLD=0.45
MOCK_PAYMENTS=true
# For deployment, include the exact HTTPS website origin and https://localhost
# for the Capacitor Android WebView. Keep local origins during development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
ADMIN_EMAILS=admin@neighborlend.com
