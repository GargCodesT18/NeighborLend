{
  "appId": "com.neighborlend.app",
  "appName": "NeighborLend",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false,
        "linkedin": false,
        "tiktok": false,
        "telegram": false
      }
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b1220",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
